# Template do .env de PRODUÇÃO (VPS). Passo a passo em docs/07-deploy.md.
# No servidor: cp .env.production.example .env && php artisan key:generate
# Nunca versione o .env preenchido.

APP_NAME="Radar Mensal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Subdomínio DuckDNS (ou domínio próprio), sempre com https.
APP_URL=https://SEU-SUBDOMINIO.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Um arquivo por dia, 14 dias de retenção (config/logging.php → daily).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=monthly_radar
DB_USERNAME=radar_app
# Senha forte, gerada no servidor: openssl rand -base64 24
DB_PASSWORD=

# Único usuário do app — consumido pelo UserSeeder.
# Em produção o seeder RECUSA senha com menos de 12 caracteres ou o valor de exemplo.
# Gere com: openssl rand -base64 18
RADAR_USER_EMAIL=
RADAR_USER_PASSWORD=

# Opcional. Vazio = enriquecimento desligado (enrichment_status=skipped).
ANTHROPIC_API_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessão só trafega em HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sem e-mail no app: o link de "esqueci a senha" vai para storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="radar@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
